#!/bin/bash
#
# Stub `gh-axi` for the agent-loop test suite.
#
# Records its argv in $STUB_CALLS and answers from $STUB_FIXTURES. Every answer
# goes out the way the real gh-axi answers a `--jq 'tojson|@base64' --full`
# read — TOON, with the JSON body base64'd into it — because that round trip is
# the seam the scripts are built on and a stub that skipped it would leave the
# seam untested.
#
#   api /user                the identity behind the token
#   api POST graphql ...     dispatched on the query text. Note the path has no
#                            leading slash: that literal is what makes gh hoist
#                            --field arguments into GraphQL variables. Called as
#                            `/graphql` with variables, this stub answers with
#                            the null-variable refusal real GitHub answers with.
#                            Dispatched on:
#                              issues(labels: ["ready-for-agent"])
#                                the ready-issue query, answered from
#                                issues-$STUB_ISSUES.json (default: none)
#                              issues(labels: ["agent-in-progress"])
#                                the claimed-issue query the startup reclaim
#                                makes, from claimed-$STUB_CLAIMED.json
#                                (default: none)
#                              is:pr is:open
#                                the global open-PR search, from
#                                prs-$STUB_PRS.json (default: none)
#                              is:pr is:merged
#                                the close-out phase's search, from
#                                merged-$STUB_MERGED.json (default: none)
#                              reviewThreads
#                                the thread list, from threads-<number>.json
#                                when that fixture exists and from
#                                threads-$STUB_THREADS.json (default: eligible)
#                                otherwise
#   api /repos/<o>/<n>       repo resolution, only for repos listed in
#                            repos.txt; anything else 404s like the real CLI
#   api /repos/<o>/<n>/labels
#                            the repo's labels, from repos.txt's second field
#   api /repos/.../issues/<number>
#                            one issue, answered from issue-<number>.json — but
#                            reported closed once a close PATCH has landed on
#                            it, so a second pass sees what the first one did
#   api /repos/.../issues/<number>/dependencies/blocked_by
#                            the issue's blockers, from blocked-<number>.json
#                            when that fixture exists and `[]` otherwise
#   api PUT /repos/<o>/<n>/pulls/<number>/merge
#                            the merge, which must carry both --field sha= and
#                            --field merge_method= or the stub refuses it
#   pr comment <number> --body <text>
#                            a pull-request comment carrying a literal body —
#                            the seam's own CodeRabbit commands, visible in the
#                            recorded argv
#   pr comment <number> --body-file <path>
#                            a pull-request comment carrying free text; the file
#                            is copied whole to $STUB_STATE/pr-body-<number>.txt
#                            so a test can compare it byte for byte
#   pr edit <number> --add-label <name>
#                            a label add, recorded by its argv
#   issue edit <number> --add-label / --remove-label
#                            a label swap, recorded by its argv
#   issue edit <number> --body-file <path>
#                            a body rewrite; the file is copied whole to
#                            $STUB_STATE/body-<number>.txt so a test can compare
#                            it byte for byte
#   issue close <number>     a close, recorded so a later read of the same issue
#                            reports it closed
#   label create --name ...  the loop's own two labels
#
# $STUB_GH_FAIL names a command that must fail: "issues", "claim", "prs",
# "merged", "issue", "body", "close", "threads", "blockers", "labels",
# "pr-comment", "pr-edit" or "merge". $STUB_GH_ERROR names which rendering it
# fails with, from fixtures/gh-error-<name>.txt. $STUB_GH_STDERR makes that
# failure gh-axi's own rather than GitHub's — reported on stderr, with stdout
# left empty.

set -uo pipefail

printf 'gh-axi %s\n' "$*" >> "$STUB_CALLS"

# A refusal from GitHub goes out on *stdout* as TOON and exits 1, which is what
# gh-axi really does.
#
# **Which refusal is injected is chosen per call.** The stub used to emit one
# canned string for every injected failure, and that string — `code: HTTP_ERROR`
# — is not one gh-axi can produce at all: its `mapGhError` table has no such
# code, and the status-carrying failures it does produce arrive as `UNKNOWN`. A
# stub that can only emit one shape cannot test a rule whose whole job is to
# tell two shapes apart, so the renderings live in `fixtures/gh-error-*.txt` and
# $STUB_GH_ERROR names the one this run gets. Three of them are measured against
# real GitHub; see fixtures/gh-errors.md.
#
# The second argument is the handler's default when $STUB_GH_ERROR says nothing,
# so a test that only wants *a* failure still gets a plausible one.
#
# $STUB_GH_STDERR switches to gh-axi's *other* failure shape: a failure of its
# own rather than GitHub's — a rejected flag, a broken token — which it reports
# on stderr and leaves stdout empty. A caller that only forwards stdout emits
# nothing at all in that case, so the two shapes have to be separable here.
fail_if() {
  [[ "${STUB_GH_FAIL:-}" == "$1" ]] || return 0
  local name="${STUB_GH_ERROR:-${2:-500}}" file
  file="$STUB_FIXTURES/gh-error-$name.txt"
  # A name with no fixture behind it is the test's own mistake, and answering it
  # with some other refusal would let that mistake pass as a result.
  [[ -f "$file" ]] || { echo "stub gh-axi: no error fixture named $name" >&2; exit 1; }
  if [[ -n "${STUB_GH_STDERR:-}" ]]; then
    cat "$file" >&2
  else
    cat "$file"
  fi
  exit 1
}

# The value of a flag in the recorded argv, or empty when it is absent.
flag_value() {
  local want="$1" i j
  shift
  for (( i = 1; i <= $#; i++ )); do
    [[ "${!i}" == "$want" ]] || continue
    j=$((i + 1))
    [[ "$j" -le "$#" ]] && printf '%s' "${!j}"
    return 0
  done
}

# Every read comes back the way `--jq 'tojson|@base64' --full` renders one.
emit() {
  printf 'api_response:\n  body: %s\n  truncated: false\n' "$(base64 <<< "$1" | tr -d '\n')"
}

emit_file() { emit "$(cat "$1")"; }

# The labels a repo already carries, from repos.txt's second field.
repo_labels() {
  awk -F'\t' -v r="$1" '$1 == r { print $2 }' "$STUB_FIXTURES/repos.txt"
}

if [[ "${1:-}" == "label" ]]; then
  # Only `create` is reached: the loop reads the existing labels over the API.
  [[ "${2:-}" == "create" ]] || { echo "stub gh-axi: unhandled label subcommand: ${2:-}" >&2; exit 1; }
  printf 'label:\n  created: true\n'
  exit 0
fi

if [[ "${1:-}" == "pr" ]]; then
  number="${3:-}"
  case "${2:-}" in
    comment)
      # Fail-closed on the far end's own rule: `gh-axi pr comment` requires
      # exactly one of --body / --body-file, so a seam that sent neither, or
      # both, would be well-formed argv and wrong at GitHub.
      body=$(flag_value --body "$@")
      file=$(flag_value --body-file "$@")
      if [[ -n "$body" && -n "$file" ]]; then
        echo "stub gh-axi: pr comment takes --body or --body-file, not both" >&2
        exit 1
      fi
      if [[ -z "$body" && -z "$file" ]]; then
        echo "stub gh-axi: pr comment needs --body or --body-file" >&2
        exit 1
      fi
      fail_if pr-comment 404
      if [[ -n "$file" ]]; then
        # Copied whole so a test can compare it byte for byte rather than
        # grepping the flattened argv — free text is exactly the thing the
        # argv line cannot carry faithfully.
        [[ -f "$file" ]] || { echo "stub gh-axi: no such --body-file: $file" >&2; exit 1; }
        cp "$file" "$STUB_STATE/pr-body-$number.txt"
      fi
      printf 'comment:\n  pr: %s\n  created: true\n' "$number"
      exit 0
      ;;
    edit)
      [[ -n "$(flag_value --add-label "$@")" ]] \
        || { echo "stub gh-axi: unhandled pr edit without --add-label" >&2; exit 1; }
      fail_if pr-edit 404
      printf 'pr:\n  number: %s\n  edited: true\n' "$number"
      exit 0
      ;;
    *)
      echo "stub gh-axi: unhandled pr subcommand: ${2:-}" >&2
      exit 1
      ;;
  esac
fi

if [[ "${1:-}" == "issue" ]]; then
  number="${3:-}"
  case "${2:-}" in
    close)
      fail_if close
      # Recorded, so a later read of the same issue sees it closed rather than
      # handing the loop the open fixture over and over.
      : > "$STUB_STATE/closed-$number"
      printf 'issue:\n  number: %s\n  state: closed\n' "$number"
      exit 0
      ;;
    edit) ;;
    *) echo "stub gh-axi: unhandled issue subcommand: ${2:-}" >&2; exit 1 ;;
  esac

  if [[ "$*" == *"--body-file"* ]]; then
    fail_if body
    file=""
    for (( i = 1; i <= $#; i++ )); do
      [[ "${!i}" == "--body-file" ]] || continue
      j=$((i + 1))
      file="${!j}"
    done
    # Copied whole so a test can compare it byte for byte rather than grepping
    # the flattened argv.
    [[ -n "$file" && -f "$file" ]] || { echo "stub gh-axi: no --body-file" >&2; exit 1; }
    cp "$file" "$STUB_STATE/body-$number.txt"
    printf 'issue:\n  number: %s\n' "$number"
    exit 0
  fi

  # A label edit: the claim, the reclaim, or the unclaim that follows a close.
  fail_if claim
  printf 'issue:\n  number: %s\n' "$number"
  exit 0
fi

if [[ "${1:-}" != "api" ]]; then
  echo "stub gh-axi: unhandled command: $*" >&2
  exit 1
fi

# `api [<method>] <path>` — the method is optional and defaults to GET.
method=GET
path="${2:-}"
case "$path" in
  GET|POST|PUT|PATCH|DELETE|HEAD) method="$path"; path="${3:-}" ;;
esac

if [[ "$path" == "graphql" || "$path" == "/graphql" ]]; then
  query="$*"
  # gh hoists --field arguments into GraphQL variables only when the path is
  # the literal `graphql`. Spelled `/graphql` they are posted as ordinary body
  # keys instead, so every declared variable reaches GitHub as null and the
  # mutation is refused with a 200 and an `errors` block. Reproduced here so
  # the seam is tested rather than assumed: a caller that passes variables down
  # the slashed path gets the same refusal it would get from real GitHub.
  if [[ "$path" == "/graphql" ]]; then
    want_field=false
    for arg in "$@"; do
      if $want_field; then
        want_field=false
        if [[ "$arg" != query=* ]]; then
          emit "{\"errors\":[{\"message\":\"Variable \$${arg%%=*} was provided invalid value\",\"extensions\":{\"value\":null}}]}"
          exit 0
        fi
      elif [[ "$arg" == "--field" ]]; then
        want_field=true
      fi
    done
  fi
  case "$query" in
    *reviewThreads*)
      fail_if threads
      number=$(sed -n 's/.*pullRequest(number: \([0-9]*\)).*/\1/p' <<< "$query")
      if [[ -f "$STUB_FIXTURES/threads-$number.json" ]]; then
        emit_file "$STUB_FIXTURES/threads-$number.json"
      else
        emit_file "$STUB_FIXTURES/threads-${STUB_THREADS:-eligible}.json"
      fi
      ;;
    *'is:pr is:merged'*)
      fail_if merged
      emit_file "$STUB_FIXTURES/merged-${STUB_MERGED:-none}.json"
      ;;
    *'is:pr is:open'*)
      fail_if prs
      emit_file "$STUB_FIXTURES/prs-${STUB_PRS:-none}.json"
      ;;
    *'labels: ["agent-in-progress"]'*)
      fail_if issues
      emit_file "$STUB_FIXTURES/claimed-${STUB_CLAIMED:-none}.json"
      ;;
    *'issues(labels:'*)
      fail_if issues
      emit_file "$STUB_FIXTURES/issues-${STUB_ISSUES:-none}.json"
      ;;
    *)
      echo "stub gh-axi: unhandled graphql query: $query" >&2
      exit 1
      ;;
  esac
  exit 0
fi

if [[ "$path" == "/user" ]]; then
  emit '{"login":"nywleswoey"}'
  exit 0
fi

if [[ "$path" == *"/dependencies/blocked_by" ]]; then
  fail_if blockers
  number="${path%/dependencies/blocked_by}"
  number="${number##*/}"
  if [[ -f "$STUB_FIXTURES/blocked-$number.json" ]]; then
    emit_file "$STUB_FIXTURES/blocked-$number.json"
  else
    emit '[]'
  fi
  exit 0
fi

if [[ "$path" == */labels ]]; then
  fail_if labels
  repo="${path#/repos/}"
  repo="${repo%/labels}"
  emit "$(tr ',' '\n' <<< "$(repo_labels "$repo")" | grep . | jq -R '{name: .}' | jq -s -c '.')"
  exit 0
fi

# The merge. A raw API call rather than `gh-axi pr merge`, because only the raw
# call can carry the `sha=` assertion — which is the whole reason the seam
# reaches for it, so the stub fails closed on its absence rather than merging
# whatever it was handed.
if [[ "$path" == /repos/*/*/pulls/*/merge ]]; then
  [[ "$method" == "PUT" ]] \
    || { echo "stub gh-axi: merge takes PUT, not $method" >&2; exit 1; }
  [[ "$*" == *"--field sha="* ]] \
    || { echo "stub gh-axi: merge without a sha assertion" >&2; exit 1; }
  [[ "$*" == *"--field merge_method="* ]] \
    || { echo "stub gh-axi: merge without a merge method" >&2; exit 1; }
  fail_if merge
  # GitHub answers with the *merge* commit, not the one asserted, so the stub
  # does too. Nothing is recorded under $STUB_STATE: a test that wants to know
  # which commit was merged reads the argv, which is where the assertion lives,
  # and an unread file here would be the first thing to trip the transient
  # case's assertion that a failed merge leaves the state directory empty.
  emit '{"sha":"11ee66e511ee66e511ee66e511ee66e511ee66e5","merged":true,"message":"Pull Request successfully merged"}'
  exit 0
fi

if [[ "$path" == /repos/*/*/issues/* ]]; then
  fail_if issue
  number="${path##*/}"
  if [[ -f "$STUB_STATE/closed-$number" ]]; then
    emit "$(printf '{"number":%s,"state":"closed","labels":[],"body":""}' "$number")"
  else
    emit_file "$STUB_FIXTURES/issue-$number.json"
  fi
  exit 0
fi

if [[ "$path" == /repos/*/* ]]; then
  repo="${path#/repos/}"
  if awk -F'\t' -v r="$repo" '$1 == r { found = 1 } END { exit !found }' \
       "$STUB_FIXTURES/repos.txt"; then
    emit "$(jq -nc --arg r "$repo" '{full_name: $r}')"
    exit 0
  fi
  printf 'error: "gh: Not Found (HTTP 404)"\ncode: NOT_FOUND\n'
  exit 1
fi

echo "stub gh-axi: unhandled api path: $path" >&2
exit 1
